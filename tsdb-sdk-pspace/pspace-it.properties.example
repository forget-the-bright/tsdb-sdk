# 力控 pSpace 7.1 联调/模拟环境集成测试配置示例。
# 复制为 pspace-it.properties（已被 .gitignore 排除）后按现场修改。
#
# 也可以不用文件，改用系统属性（-Dpspace.it.baseUrl=...）或环境变量（PSPACE_IT_BASE_URL）。
# 优先级：系统属性 pspace.it.* > 环境变量 PSPACE_IT_* > 本文件 > 内置默认值。
#
# 只读用例：  mvn -o -pl tsdb-sdk-pspace -Dpspace.it=true -Dtest=PspaceReadOnlyIT test
# 写/造数用例：在上面基础上再加 -Dpspace.it.allow-write=true；
#              且 baseUrl 主机必须在白名单 {127.0.0.1, localhost, 172.16.176.14} 内。
#              环境已有可用点位时不建点，写用例自动跳过。

# pSpace Web API 根地址；明文 http 由测试夹具显式放行，生产应改为 TLS 代理
baseUrl=http://172.16.176.14:8080

# 收发字符集：gbk | utf-8。现场 7.1 无论传什么实际都按 GBK 收发。
charset=gbk

connectTimeoutMs=5000
readTimeoutMs=30000

# 目录翻页参数（探测点位时用 500/页；翻页按服务端 page.count 结束）
pageSize=1000

# 缓存未热时自动 POST /Refresh 并重试一次；refreshMinIntervalMs 为两次刷新最小间隔
autoRefresh=true
refreshMinIntervalMs=1000